<?xml version="1.0" encoding="utf-8"?>
<!-- The logo glyph (assets/icons/logo.svg) at 2.5x in the middle of the 108 dp adaptive canvas: about the 48 dp logo
     size the adaptive icon guide suggests, with the bar's round caps 30 dp from the centre, inside the 66 dp safe zone.
     Also the monochrome layer: themed icons keep only its alpha. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.5"
        android:scaleY="2.5"
        android:translateX="24"
        android:translateY="24">
        <path
            android:pathData="M12,4L12,15M12,15L7,10M12,15L17,10M5,20L19,20"
            android:strokeColor="@color/ic_launcher_glyph"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
